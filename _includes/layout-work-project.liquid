{% include '_head.liquid' %}

<article>
  <p><a href="/work-preview/">← Selected work</a></p>

  <header class="content-header">
    <h1 class="content-heading">{{ title }}</h1>
  </header>

  {{ content }}

  {% assign heroImage = hero | default: thumb %}
  {% if heroImage %}
  <picture>
    <img
      src="{{ heroImage }}"
      alt=""
      loading="eager"
      decoding="async"
    />
  </picture>
  {% endif %}

  {% if liveUrl %}
  <div class="button">
    <a href="{{ liveUrl }}" target="_blank" rel="noopener noreferrer">See site</a>
  </div>
  {% endif %}
</article>

{% include '_foot.html' %}
