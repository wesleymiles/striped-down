<div class="library-view-toggle" role="group" aria-label="Library layout">
  <button
    type="button"
    class="library-view-toggle__btn is-active"
    data-library-view="default"
    aria-pressed="true"
    aria-label="Default view"
    title="Default view"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="3" y="3" width="8" height="8" rx="1"></rect>
      <rect x="13" y="3" width="8" height="8" rx="1"></rect>
      <rect x="3" y="13" width="8" height="8" rx="1"></rect>
      <rect x="13" y="13" width="8" height="8" rx="1"></rect>
    </svg>
  </button>
  <button
    type="button"
    class="library-view-toggle__btn"
    data-library-view="compact"
    aria-pressed="false"
    aria-label="Compact view"
    title="Compact view"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="3" y="3" width="4" height="4" rx="0.5"></rect>
      <rect x="10" y="3" width="4" height="4" rx="0.5"></rect>
      <rect x="17" y="3" width="4" height="4" rx="0.5"></rect>
      <rect x="3" y="10" width="4" height="4" rx="0.5"></rect>
      <rect x="10" y="10" width="4" height="4" rx="0.5"></rect>
      <rect x="17" y="10" width="4" height="4" rx="0.5"></rect>
      <rect x="3" y="17" width="4" height="4" rx="0.5"></rect>
      <rect x="10" y="17" width="4" height="4" rx="0.5"></rect>
      <rect x="17" y="17" width="4" height="4" rx="0.5"></rect>
    </svg>
  </button>
</div>
