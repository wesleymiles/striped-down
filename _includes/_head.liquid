<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">

	<!-- When to insert different head items per page  -->
    {% if noindex %}
		<meta name="robots" content="noindex,nofollow">		
	{% endif %}
	
	{% if page.url == '/one-week-logo/' %}
		<!-- Include Lottie library -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js" type="text/javascript"></script>
	{% endif %}

	{% if page.url == '/blog/tag/trip-report/' %}
		<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
		<script src="{{ '/js/trip-report-chart.js' | url }}"></script>
	{% endif %}

	{% if page.url == '/art/' or page.url == '/' %}
		<!-- Include lightbox gallery -->
		<link rel="stylesheet" href="/photoswipe/dist/photoswipe.css">
	{% endif %}

	{% if page.url == '/blog/tag/art/' %}
		<!-- <meta name="follow.it-verification-code" content="bAHXdJ3wHhejG0Sd9p2r"/> -->
	{% endif %}



    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} — Wes</title>

	<!-- SEO Tags -->
	{% if description %}
		{% assign descriptionPlain = description | strip_html %}
		<meta name="description" content="{{ descriptionPlain }}" />
	{% endif %}

	<meta property="og:title" content="{{ title }}"/>
	<link rel="canonical" href="{{ siteUrl }}{{ page.url }}" />
	<meta property="og:url" content="{{ siteUrl }}{{ page.url }}"/>
	<meta property="og:type" content="website"/>
	<meta name="twitter:card" content="summary_large_image"/>
	{% if description %}
		{% assign descriptionPlain = description | strip_html %}
		<meta property="og:description" content="{{ descriptionPlain }}"/>
	{% endif %}


<meta property="og:image" content="{{ ogImageUrl }}"/>
	<meta name="twitter:image" content="{{ ogImageUrl }}"/>

<link rel="preload" as="font" type="font/otf" crossorigin href="{{ '/fonts/BagnardSans.otf' | url }}">
<link rel="preload" as="font" type="font/otf" crossorigin href="{{ '/fonts/Bagnard.otf' | url }}">
<link rel="preload" as="font" type="font/ttf" crossorigin href="{{ '/fonts/PublicSans-Regular.ttf' | url }}">


    <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  	<link rel="stylesheet" href="{{ '/css/fonts.css' | url }}">	
	{% if tags contains 'tab' %}
		<link rel="stylesheet" href="{{ '/css/tabs.css' | url }}">
	{% endif %}
<!-- <link rel="preconnect" href="https://fonts.googleapis.com"> -->
<!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> -->
<!-- <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" rel="stylesheet"> -->
<!-- <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap" rel="stylesheet"> -->
<!-- <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> -->

    <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="48x48">
	<link rel="icon" href="{{ '/img/icon.svg' | url }}" type="image/svg+xml">
	<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">

  </head>

	<body class="{{ title }} {{ tags | join: " " }}{% if tags contains 'work-preview' %} work-preview Web{% endif %}">
  	<a class="skip-link nav-tab" href='#main'>Skip to content</a>
		<header class="mast">
			<nav aria-label="Main">

				<div class="site-logo">
					<a href="/">
						<img src="/img/juniper-left.png"  title="Head home" alt="juniper bough illustration" />
						<!-- <img src="/img/chipmunk.png" title="Head home" alt="Tiny chipmunk illustration" width="200" /> -->
					</a>
				</div>

				{% assign navPages = collections.all | eleventyNavigation %}
				<ul class="nav-menu">
					{%- for entry in navPages %}
					  <li{% 
					  	if entry.url == page.url %}
					  		class="active-nav"{% endif %}>
					    	<a href="{{ entry.url }}">{{ entry.title }}</a>
				  	</li>
					{%- endfor %}
					</ul>

			</nav>

		</header>

	<main id="main">